{
  "name": "vantara",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "convex:dev": "npx convex dev",
    "convex:deploy": "npx convex deploy",
    "convex:seed": "npx convex run seed:run",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3005 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "next build && electron-builder --win",
    "electron:build:mac": "next build && electron-builder --mac",
    "electron:build:linux": "next build && electron-builder --linux",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "build:mobile": "cross-env NEXT_EXPORT=true next build && npx cap sync",
    "setup": "node scripts/setup.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@convex-dev/better-auth": "^0.12.2",
    "@stripe/react-stripe-js": "^6.5.0",
    "@stripe/stripe-js": "^9.7.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.13",
    "clsx": "^2.1.1",
    "convex": "^1.40.0",
    "country-state-city": "^3.2.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.3.19",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.400.0",
    "next": "^14.2.35",
    "posthog-js": "^1.378.1",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.12.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.vantara.app",
    "productName": "Vantara",
    "copyright": "Copyright © 2026 Vantara",
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "files": [
      "**/*",
      "electron/**/*",
      "!src",
      "!**/*.map",
      "!.data"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns",
      "category": "public.app-category.lifestyle"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
