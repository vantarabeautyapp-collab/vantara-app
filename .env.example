# ============================================================
# StyleAfrique — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================


# ─── APP ─────────────────────────────────────────────────────────────────────
# Your app's public URL. Use http://localhost:3005 in development.
# Set to your Railway URL in production: https://styleafrique.up.railway.app
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Short-lived JWT secret for the legacy auth system (fallback).
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In Railway: set this in the service's Variables tab.
JWT_SECRET=


# ─── CONVEX (DATABASE) ───────────────────────────────────────────────────────
# 1. Create account at https://convex.dev
# 2. Run:  npx convex dev
#    This creates your deployment and fills these values automatically.
# 3. To deploy to production: npx convex deploy
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Site URL used by Better-Auth inside Convex functions.
# Same as NEXT_PUBLIC_APP_URL but set in Convex env vars via:
#   npx convex env set SITE_URL https://your-app.railway.app
SITE_URL=http://localhost:3005


# ─── BETTER-AUTH (AUTHENTICATION) ───────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Also set this in Convex env vars: npx convex env set BETTER_AUTH_SECRET <value>
BETTER_AUTH_SECRET=


# ─── GOOGLE OAUTH ────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create project → APIs & Services → Credentials → OAuth 2.0 Client ID
# 3. Application type: Web application
# 4. Authorized redirect URIs:
#      http://localhost:3005/api/auth/callback/google
#      https://your-app.railway.app/api/auth/callback/google
# Also set in Convex: npx convex env set GOOGLE_CLIENT_ID <value>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ─── FACEBOOK OAUTH ──────────────────────────────────────────────────────────
# 1. Go to https://developers.facebook.com → My Apps → Create App
# 2. Add Facebook Login product
# 3. Authorized redirect URIs:
#      https://your-app.railway.app/api/auth/callback/facebook
# Note: Facebook requires HTTPS — use your Railway URL even during dev testing.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=


# ─── MICROSOFT OAUTH ─────────────────────────────────────────────────────────
# 1. Go to https://portal.azure.com → Azure Active Directory → App registrations
# 2. New registration → Web platform
# 3. Redirect URIs:
#      http://localhost:3005/api/auth/callback/microsoft
#      https://your-app.railway.app/api/auth/callback/microsoft
# Tenant: "common" allows any Microsoft account (personal + work)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common


# ─── STRIPE (PAYMENTS) ───────────────────────────────────────────────────────
# 1. Create account at https://stripe.com
# 2. Get keys from https://dashboard.stripe.com/apikeys
# 3. For webhooks: Dashboard → Developers → Webhooks → Add endpoint
#      URL: https://your-app.railway.app/api/webhooks/stripe
#      Events: checkout.session.completed, customer.subscription.deleted, invoice.payment_failed
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create in Dashboard → Products → Add product
# Monthly subscription prices in USD
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_ELITE_MONTHLY=price_...


# ─── LOCAL AFRICAN PAYMENTS (FUTURE) ─────────────────────────────────────────
# M-Pesa (Kenya, Tanzania) — https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-app.railway.app/api/payments/mpesa/callback

# Flutterwave (Nigeria, Ghana, and 30+ African countries) — https://developer.flutterwave.com
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# Paystack (Nigeria, Ghana, South Africa) — https://paystack.com/developers
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=


# ─── POSTHOG (ANALYTICS) ─────────────────────────────────────────────────────
# 1. Create account at https://posthog.com
# 2. Create project → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com


# ─── SENTRY (ERROR TRACKING) ─────────────────────────────────────────────────
# 1. Create account at https://sentry.io
# 2. Create Next.js project → Project Settings → Client Keys → DSN
# 3. For source maps: Settings → Developer Settings → Auth Tokens → Create token
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=


# ─── LINEAR (ISSUE TRACKING) ─────────────────────────────────────────────────
# 1. Create account at https://linear.app
# 2. Settings → API → Personal API keys → Create key
# 3. Get team ID from Settings → Workspace → Teams → your team
LINEAR_API_KEY=lin_api_...
LINEAR_TEAM_ID=


# ─── TERMLY (PRIVACY POLICY) ─────────────────────────────────────────────────
# 1. Create account at https://termly.io
# 2. Add Policy → Privacy Policy → Generate
# 3. Embed → copy the data-id value from the embed code
NEXT_PUBLIC_TERMLY_POLICY_ID=


# ─── RAILWAY DEPLOYMENT ──────────────────────────────────────────────────────
# Automatically set by Railway — do NOT set manually.
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PUBLIC_DOMAIN=styleafrique.up.railway.app


# ─── OPTIONAL: DATA PATH ─────────────────────────────────────────────────────
# Where to store the local JSON user database (legacy, before Convex migration).
# Defaults to .data/ in project root. Set to absolute path in production.
# DATA_PATH=/home/user/.styleafrique/data
