# ============================================================
# Vantara — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================


# ─── APP ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3005
NEXT_PUBLIC_PRODUCTION_URL=https://vantarafrique.com

# Short-lived JWT secret (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=


# ─── CONVEX (DATABASE) ───────────────────────────────────────────────────────
# Run: npx convex dev  — fills these automatically
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
SITE_URL=http://localhost:3005


# ─── BETTER-AUTH ─────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=


# ─── GOOGLE OAUTH ─────────────────────────────────────────────────────────────
# Setup: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client
#
# Authorised redirect URIs to register:
#   https://vantarafrique.com/api/auth/google/callback
#   http://localhost:3005/api/auth/google/callback
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ─── STRIPE (SUBSCRIPTION PAYMENTS) ──────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
# Webhook: Dashboard → Developers → Webhooks
#   URL: https://vantarafrique.com/api/webhooks/stripe
#   Events: checkout.session.completed, customer.subscription.deleted, invoice.payment_failed
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_


# ─── FLUTTERWAVE (AFRICAN BOOKING PAYMENTS) ───────────────────────────────────
# https://developer.flutterwave.com
# Supports: Nigeria, Ghana, Uganda, Tanzania, Kenya, South Africa, Rwanda, and more.
# One account covers 30+ African countries.
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-


# ─── M-PESA DARAJA (KENYA STK PUSH — DIRECT) ─────────────────────────────────
# https://developer.safaricom.co.ke
# Use for direct Kenya M-Pesa STK push (lower fees than Flutterwave for KE).
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://vantarafrique.com/api/payments/mpesa/callback


# ─── ANALYTICS ────────────────────────────────────────────────────────────────
# PostHog — https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Google Analytics 4 — https://analytics.google.com → Admin → Data Streams → Web
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-


# ─── SEO VERIFICATION ─────────────────────────────────────────────────────────
# Google Search Console: Settings → Ownership → HTML tag → content value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools: Settings → Site verification → XML / meta tag value
NEXT_PUBLIC_BING_VERIFICATION=


# ─── LINEAR (ERROR → ISSUE TRACKING) ─────────────────────────────────────────
# https://linear.app → Settings → API → Personal API keys
# Get team ID: Settings → Workspace → Teams → your team → ID
LINEAR_API_KEY=lin_api_
LINEAR_TEAM_ID=


# ─── TERMLY (OPTIONAL POLICY EMBED) ──────────────────────────────────────────
# https://termly.io — If set, replaces the built-in privacy policy text with your Termly policy
NEXT_PUBLIC_TERMLY_POLICY_ID=


# ─── DATA STORAGE ─────────────────────────────────────────────────────────────
# Where to store the local JSON user database (before Convex migration)
# Defaults to .data/ in project root. Railway: set /data for persistent storage.
DATA_PATH=/data


# ─── RAILWAY (SET IN RAILWAY VARIABLES TAB) ───────────────────────────────────
# NODE_ENV=production           (auto-set by Railway)
# PORT=3000                     (leave unset — Railway manages this)
# RAILWAY_PUBLIC_DOMAIN         (auto-set by Railway)
